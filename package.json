{
  "name": "constela-edu",
  "private": true,
  "version": "1.0.0",
  "description": "Constela Edu — Gestão e Premiação Escolar (monorepo multiplataforma)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @constela/web",
    "build:web": "npm run build --workspace @constela/web",
    "dev:mobile": "npm run start --workspace @constela/mobile",
    "typecheck:mobile": "npm run typecheck --workspace @constela/mobile",
    "dev:desktop": "npm run tauri:dev --workspace @constela/desktop",
    "build:desktop": "npm run tauri:build --workspace @constela/desktop"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
