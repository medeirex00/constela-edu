# Copie para .env antes de rodar: docker compose up -d
# ---------------------------------------------------------------------------

# Senha do PostgreSQL (troque por algo forte e único).
# POSTGRES_PASSWORD só com letras e dígitos (vai crua na DATABASE_URL do compose):
# um "%41" vira outra senha em silêncio e um "@" desloca o host. Gere com:
#   openssl rand -hex 32
POSTGRES_PASSWORD=troque-esta-senha

# As duas chaves abaixo vêm VAZIAS de propósito: cole em cada uma um valor que
# VOCÊ gerou, uma chamada por chave (os dois valores têm de ser diferentes):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ou: openssl rand -hex 32
# Vazias, o docker compose nem sobe ("defina SECRET_KEY no .env"). Em produção
# (ENV=producao já vem no compose) o sistema também RECUSA subir com menos de 32
# caracteres ou com um valor de exemplo publicado no repositório.

# Segredo de assinatura dos tokens de login.
SECRET_KEY=

# Chave PRÓPRIA da cifra em repouso (credenciais das plataformas, chave de IA),
# DIFERENTE da SECRET_KEY. Em produção o sistema RECUSA subir sem ela, com ela
# igual à SECRET_KEY ou com um valor de exemplo. Dados já cifrados continuam legíveis.
DATA_ENCRYPTION_KEY=

# Porta pública do site no cenário SEM HTTPS (acesso por http://SERVIDOR:8080).
PORTA_WEB=8080

# Interface em que a porta acima é publicada:
#   * Sem HTTPS, em rede local: deixe 0.0.0.0 (acesso pelo IP do servidor).
#   * COM HTTPS (perfil https): use 127.0.0.1 — o Caddy alcança o site pela
#     rede interna e a porta 8080 não deve ficar exposta. O Docker abre portas
#     ANTES do ufw, então publicar em 0.0.0.0 contornaria o firewall e o TLS.
WEB_BIND=0.0.0.0

# Publicação na internet com HTTPS automático:
#   docker compose --profile https up -d
# DOMINIO deve apontar (registro DNS tipo A) para o IP do servidor.
DOMINIO=constela.suaescola.com.br
PUBLIC_BASE_URL=https://constela.suaescola.com.br

# Backup automático diário (pg_dump + uploads, retenção de 14 dias):
#   docker compose --profile backup up -d
# Os arquivos ficam em ./backups — copie-os regularmente para fora do servidor.

# Assistente de IA (opcional — "local" funciona sem chave)
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=

# ---------------------------------------------------------------------------
# Produção CROSS-ORIGIN (front e API em domínios DIFERENTES, ex.: Vercel + Railway)
# e métricas. No compose padrão o nginx serve site e API na MESMA origem, então
# o CORS NÃO é necessário aqui; estas variáveis existem para o deploy real e
# devem ser configuradas conforme a SUA infraestrutura (ex.: painel do Railway).
# Para usá-las no compose, encaminhe-as no serviço backend do docker-compose.yml.
# ---------------------------------------------------------------------------

# Origens do front autorizadas a chamar a API. FORMATO OBRIGATÓRIO: array JSON
# (vírgula-separado NÃO funciona e impede a app de subir). Sem isto, em produção
# cross-origin o navegador BLOQUEIA as chamadas ("abre mas não funciona").
# CORS_ORIGINS=["https://www.constelaedu.com","https://quest.constelaedu.com"]

# Protege /metrics (Prometheus). Se definido, o scrape exige
# Authorization: Bearer <token>. Em produção SEM token, /metrics responde 404
# (fail-closed) — as métricas nunca ficam públicas. Vazio = desligado.
# METRICS_TOKEN=
