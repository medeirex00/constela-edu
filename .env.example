# Copie para .env antes de rodar: docker compose up -d
# ---------------------------------------------------------------------------

# Senha do PostgreSQL (troque por algo forte e único).
POSTGRES_PASSWORD=troque-esta-senha

# Segredo de assinatura dos tokens de login. GERE UM VALOR ALEATÓRIO:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Em produção (ENV=producao já vem no compose) o sistema RECUSA subir com o
# valor padrão ou com menos de 32 caracteres.
SECRET_KEY=gere-uma-chave-longa-e-aleatoria

# Porta pública do site no cenário SEM HTTPS (acesso por http://SERVIDOR:8080).
PORTA_WEB=8080

# Interface em que a porta acima é publicada:
#   * Sem HTTPS, em rede local: deixe 0.0.0.0 (acesso pelo IP do servidor).
#   * COM HTTPS (perfil https): use 127.0.0.1 — o Caddy alcança o site pela
#     rede interna e a porta 8080 não deve ficar exposta. O Docker abre portas
#     ANTES do ufw, então publicar em 0.0.0.0 contornaria o firewall e o TLS.
WEB_BIND=0.0.0.0

# Publicação na internet com HTTPS automático:
#   docker compose --profile https up -d
# DOMINIO deve apontar (registro DNS tipo A) para o IP do servidor.
DOMINIO=constela.suaescola.com.br
PUBLIC_BASE_URL=https://constela.suaescola.com.br

# Backup automático diário (pg_dump + uploads, retenção de 14 dias):
#   docker compose --profile backup up -d
# Os arquivos ficam em ./backups — copie-os regularmente para fora do servidor.

# Assistente de IA (opcional — "local" funciona sem chave)
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=
