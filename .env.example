# Copie para .env antes de rodar: docker compose up -d
POSTGRES_PASSWORD=troque-esta-senha
SECRET_KEY=gere-uma-chave-longa-e-aleatoria
PORTA_WEB=8080

# Publicação na internet com HTTPS automático:
#   docker compose --profile https up -d
# DOMINIO deve apontar (registro DNS tipo A) para o IP do servidor.
DOMINIO=constela.suaescola.com.br
PUBLIC_BASE_URL=https://constela.suaescola.com.br

# Assistente de IA (opcional — "local" funciona sem chave)
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=
