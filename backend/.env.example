# Copie para .env e ajuste conforme o ambiente (desenvolvimento local do backend).

# "dev" (padrão) libera tudo para desenvolvimento; "producao" ativa o
# fail-closed (exige SECRET_KEY e DATABASE_URL próprios; desliga o /docs).
ENV=dev

# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/constela

# Gere um valor real:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=gere-uma-chave-longa-e-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Chave DEDICADA para cifrar segredos em repouso (credenciais de plataforma,
# chave de IA), separada da SECRET_KEY que assina os JWT — reduz o raio de um
# vazamento e permite rotação independente. Opcional: vazia = usa a SECRET_KEY
# (dados já cifrados continuam legíveis). Gere como a SECRET_KEY.
# DATA_ENCRYPTION_KEY=gere-outra-chave-longa-e-aleatoria

# Retenção (dias) das cópias de relatórios em /exports, que contêm nomes de
# alunos. Expurgadas após este prazo (LGPD). 0 desliga o expurgo.
EXPORTS_RETENCAO_DIAS=7

# Documentação interativa (/docs, /redoc). Desligada por padrão; ligue só no
# desenvolvimento local em rede confiável.
DOCS_HABILITADOS=true

# Conta do DONO da plataforma (acesso global a TODAS as redes). VAZIA por
# padrão: um ambiente novo NUNCA nasce com conta administrativa implícita.
# Quando declarada, o boot promove a conta com este e-mail a administrador
# global (idempotente) e o e-mail passa a ser RESERVADO — nenhuma rota de
# escola pode criar usuário com ele. Deixe vazia se o acesso global já existe
# no banco. Um valor malformado faz a produção recusar a subir (fail-closed).
# ADMIN_GLOBAL_EMAIL=dono@exemplo.com

# Endereço público do frontend (link e QR code do Painel Público).
# Sem definir, usa o domínio de produção (https://www.constelaedu.com).
PUBLIC_BASE_URL=http://localhost:5173

# Assistente de IA (PRD §154) — provedor trocável, isolado no backend.
# "local" funciona sem chave (regras determinísticas sobre os dados).
AI_PROVIDER=local
# AI_PROVIDER=anthropic
# AI_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-4-8
AI_MAX_TOKENS=1024

# Origens do front autorizadas a chamar a API (allowlist estrita, sem curinga).
# FORMATO OBRIGATÓRIO: array JSON — vírgula-separado NÃO funciona e impede a app
# de subir. Necessário quando o front está em OUTRO domínio (produção cross-origin
# Vercel+Railway); sem isto o navegador bloqueia as chamadas.
# CORS_ORIGINS=["https://www.constelaedu.com","https://quest.constelaedu.com"]

# Protege /metrics (Prometheus). Definido → o scrape exige Authorization: Bearer
# <token>. Em produção SEM token, /metrics responde 404 (fail-closed). Vazio = em
# dev fica aberto; em produção fica indisponível até definir o token.
# METRICS_TOKEN=

# Retenção LGPD das conversas do assistente (dias). Padrão 90.
# IA_RETENCAO_DIAS=90
