# Copie para .env e ajuste conforme o ambiente (desenvolvimento local do backend).

# "dev" (padrão): migra o banco na inicialização do app. "producao": fail-closed
# (exige SECRET_KEY, DATA_ENCRYPTION_KEY e DATABASE_URL próprios; recusa CORS com
# curinga e DOCS_HABILITADOS=true) e NÃO migra na inicialização — rode
# `python -m scripts.migrate` antes do servidor (pre-deploy/entrypoint). Em dev o
# que a produção recusaria só vira aviso no log (exceto a DATABASE_URL malformada,
# recusada em qualquer ENV). Ver docs/operacao/PRODUCAO-ENV-E-MIGRACOES.md.
ENV=dev

# Rollback de código sobre schema mais novo e ADITIVO: ids exatos das revisões do
# banco que este código não conhece, separados por vírgula. Vazio = recusa.
# SCHEMA_ADIANTE_ACEITO=

# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/constela

# Mantenedor do pool (só PostgreSQL): no boot e a cada DB_POOL_AQUECIDO_S segundos deixa
# DB_POOL_AQUECIDO_CONEXOES conexões prontas por worker, para a requisição não pagar conexão
# nova, ping de conexão parada nem reciclagem. O intervalo fica abaixo do DB_PING_OCIOSO_S
# (30). 0 em qualquer uma desliga. Ver docs/operacao/PRODUCAO-ENV-E-MIGRACOES.md.
# DB_POOL_AQUECIDO_S=20
# DB_POOL_AQUECIDO_CONEXOES=8

# Vazia = chave aleatória efêmera em dev (as sessões caem a cada reinício, com
# aviso no log). Para persistir, cole um valor que VOCÊ gerou:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Um valor de exemplo publicado no repositório conta como vazio em dev e recusa
# o boot com ENV=producao.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Chave DEDICADA para cifrar segredos em repouso (credenciais de plataforma,
# chave de IA), separada da SECRET_KEY que assina os JWT — reduz o raio de um
# vazamento e permite rotação independente. Opcional em dev (vazia = usa a
# SECRET_KEY, com aviso no log); OBRIGATÓRIA e diferente da SECRET_KEY com
# ENV=producao (um valor de exemplo também recusa). Dados já cifrados continuam
# legíveis. Gere como a SECRET_KEY, com outra chamada.
# DATA_ENCRYPTION_KEY=

# Rotação PLANEJADA da cifra (só durante a troca; veja scripts/recifrar_segredos.py).
# SÓ DECIFRAM: nada é cifrado com elas e nenhuma valida JWT. Depois de
# `python -m scripts.recifrar_segredos --executar` com tudo na chave atual, APAGUE-AS.
# DATA_ENCRYPTION_KEYS_ANTERIORES=dek-que-saiu[,outra-dek-que-saiu]
# CHAVE_CIFRA_LEGADA_ANTERIOR=secret-key-que-saiu

# Base das pastas de arquivos (<base>/uploads e <base>/exports). Vazio = raiz do
# repositório; a imagem Docker usa /dados. Ver docs/operacao/ARMAZENAMENTO.md.
# DADOS_DIR=

# Retenção (dias) das cópias de relatórios em /exports, que contêm nomes de
# alunos. Expurgadas após este prazo (LGPD). 0 desliga o expurgo.
EXPORTS_RETENCAO_DIAS=7

# PDFs feitos com o Chromium (cartaz, certificado, relatórios), por processo. Os
# valores abaixo são os padrões do código: só descomente para mudar.
# Chromium abertos ao mesmo tempo (mínimo 1):
# PDF_NAVEGADORES_SIMULTANEOS=2
# Segundos que um pedido espera por uma vaga; esgotada a espera, o PDF sai pela
# reserva simples (fpdf), com os mesmos números (a arte do certificado da
# plataforma, que não tem reserva, responde "tente de novo"):
# PDF_ESPERA_POR_NAVEGADOR_S=30

# Diagnóstico do robô no boot (uma vez por processo, em thread de fundo): consulta
# o IP de saída em ipinfo.io/ipapi.co e abre o Chromium nas páginas de login, sem
# credenciais. Ligado por padrão (é o da produção); "false" desliga — os testes e o
# E2E desligam para não sair para a internet. Ver docs/operacao/PRODUCAO-ENV-E-MIGRACOES.md.
# AUTOMACAO_VERIFICAR_NO_BOOT=false

# Documentação interativa (/docs, /redoc). Desligada por padrão; descomente só no
# desenvolvimento local em rede confiável (com ENV=producao o boot recusa — e os
# testes que sobem um processo com ENV=producao forçam false).
# DOCS_HABILITADOS=true

# Conta do DONO da plataforma (acesso global a TODAS as redes). VAZIA por
# padrão: um ambiente novo NUNCA nasce com conta administrativa implícita.
# Quando declarada, o boot promove a conta com este e-mail a administrador
# global (idempotente) e o e-mail passa a ser RESERVADO — nenhuma rota de
# escola pode criar usuário com ele. Deixe vazia se o acesso global já existe
# no banco. Um valor malformado faz a produção recusar a subir (fail-closed).
# ADMIN_GLOBAL_EMAIL=dono@exemplo.com

# Endereço público do frontend (link e QR code do Painel Público e da vitrine da rede).
# Definido aqui, ele VALE SEMPRE. Sem definir: a tela aberta em localhost/127.0.0.1 gera o link
# com a própria origem (só abre neste computador); fora disso, o domínio de produção
# (https://www.constelaedu.com). Para o telão, o celular ou o QR em outro aparelho, use o
# endereço do servidor na rede (ex.: http://192.168.0.10:8080).
PUBLIC_BASE_URL=http://localhost:5173

# Assistente de IA (PRD §154) — provedor trocável, isolado no backend.
# "local" funciona sem chave (regras determinísticas sobre os dados).
AI_PROVIDER=local
# AI_PROVIDER=anthropic
# AI_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-4-8
AI_MAX_TOKENS=1024

# Origens do front autorizadas a chamar a API (allowlist estrita, sem curinga).
# FORMATO OBRIGATÓRIO: array JSON — vírgula-separado NÃO funciona e impede a app
# de subir. Necessário quando o front está em OUTRO domínio (produção cross-origin
# Vercel+Railway); sem isto o navegador bloqueia as chamadas. Com ENV=producao,
# '*' faz o boot recusar e as origens locais (localhost, 127.0.0.1, [::1],
# 0.0.0.0) saem da lista sozinhas; as do app desktop (tauri) ficam.
# CORS_ORIGINS=["https://www.constelaedu.com","https://quest.constelaedu.com"]

# Protege /metrics (Prometheus). Definido → o scrape exige Authorization: Bearer
# <token>. SEM token, /metrics responde 404 em qualquer ENV (fail-closed).
# METRICS_TOKEN=
# Só no desenvolvimento local: abre /metrics sem token (ignorado com ENV=producao).
# METRICS_PUBLICO=true

# Retenção LGPD das conversas do assistente (dias). Padrão 90.
# IA_RETENCAO_DIAS=90

# Quest — limites do login infantil por código (app/quest/config.py). Os padrões
# são os seguros; ver docs/lgpd/RETENCAO-TECNICA.md §2.4.
# IPv6 conta pela rede /N nas chaves de limite por IP (128 = por endereço, NÃO
# recomendado).
# QUEST_LIMITE_PREFIXO_IPV6=64
# Teto GLOBAL de falhas do login por código (todos os IPs somados): atingido, o
# login por código responde 429 na API inteira até o fim da janela e sai um log
# de alerta (evento quest.limite_global_atingido); o QR do cartão segue entrando.
# QUEST_LIMITE_GLOBAL_FALHAS=400
# QUEST_LIMITE_GLOBAL_JANELA_S=300

# Edu — tetos de FALHAS do /auth/login (app/core/config.py), persistentes no banco
# (valem entre workers e sobrevivem ao deploy). Os padrões abaixo são os do código.
# Por IP (IPv6 pela rede /64), em qualquer conta: N falhas na janela bloqueiam o IP.
# EDU_LOGIN_TETO_IP_FALHAS=50
# EDU_LOGIN_TETO_IP_JANELA_S=300
# GLOBAL (todos os IPs somados): atingido, o login de TODAS as contas responde 429
# até o fim da janela e sai um log de alerta (evento login.limite_global_atingido);
# as sessões já abertas seguem valendo. Pode subir em produção se o uso real chegar
# perto do teto — ver docs/lgpd/SESSAO-E-MFA.md §1.1. Janela de 60 a 3600 s.
# EDU_LOGIN_TETO_GLOBAL_FALHAS=400
# EDU_LOGIN_TETO_GLOBAL_JANELA_S=300
# Logins correndo AO MESMO TEMPO em cada processo (acima disso, 429 na hora, sem
# tocar no banco). Mínimo 1.
# EDU_LOGIN_SIMULTANEOS=8
