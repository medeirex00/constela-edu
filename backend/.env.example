# Copie para .env e ajuste conforme o ambiente.
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/sgpe
SECRET_KEY=gere-uma-chave-longa-e-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Endereço público do frontend (QR codes do Painel Público)
PUBLIC_BASE_URL=http://localhost:5173

# Assistente de IA (PRD §154) — provedor trocável, isolado no backend.
# "local" funciona sem chave (regras determinísticas sobre os dados).
AI_PROVIDER=local
# AI_PROVIDER=anthropic
# AI_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-4-8
AI_MAX_TOKENS=1024
