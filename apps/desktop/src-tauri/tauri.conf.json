{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Constela Edu",
  "version": "1.0.0",
  "identifier": "br.com.constelaedu.desktop",
  "mainBinaryName": "constela-edu",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist",
    "beforeDevCommand": "npm run dev --workspace @constela/web",
    "beforeBuildCommand": "npm run build --workspace @constela/web"
  },
  "app": {
    "windows": [
      {
        "title": "Constela Edu — Gestão e Premiação Escolar",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://SEU-SERVIDOR-DE-RELEASES/constela-edu/desktop/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "SUBSTITUA-PELA-CHAVE-PUBLICA-GERADA-COM: npm run tauri -w @constela/desktop signer generate"
    }
  }
}
