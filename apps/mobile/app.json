{
  "expo": {
    "name": "Constela Edu",
    "slug": "constela-edu",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "constelaedu",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icone.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFC"
    },
    "ios": {
      "bundleIdentifier": "br.com.constelaedu.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "br.com.constelaedu.mobile",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4F46E5"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "O Constela Edu usa a câmera apenas para ler QR codes do painel da escola."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "SUBSTITUA-PELO-PROJECT-ID-DO-EAS"
      }
    }
  }
}
